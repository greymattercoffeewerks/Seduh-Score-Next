VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Only the OLD slug-less audience links (/live/projector, /live/phone, /live/splash) read the slug
# (the new links, /live/<organiser-slug>/projector and so on, name the organiser themselves). With it unset
# the old links show an "out of date" card. It goes, with the shim in src/core/config.js, when the old links are
# retired. Production sets it to grey-matter-coffee-werks. The organiser console takes its organisation from the
# signed-in person's memberships.
VITE_LEGACY_AUDIENCE_ORG_SLUG=
# Optional and DEPRECATED: the same legacy links' older way to name an organisation (an id). Used only while the
# slug above is unset; production no longer sets it (removed 2026-10-13). Local development does not need it.
VITE_DEFAULT_ORG_ID=
